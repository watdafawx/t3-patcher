{
  "name": "@t3p/devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer tools: patch tester, RPC console, slot outlines and a plugin log viewer",
  "scripts": {
    "build": "t3p-plugin-build",
    "dev": "t3p-plugin-build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@t3p/api": "workspace:*",
    "@t3p/plugin-build": "workspace:*",
    "acorn": "^8.15.0",
    "jsdom": "26",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
