{
  "name": "@t3p/timeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure, runtime-free normalizer: orchestration subscribeThread snapshots and events -> timeline records with cause links",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@t3p/api": "workspace:*"
  }
}
